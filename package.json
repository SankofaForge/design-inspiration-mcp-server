{
  "name": "design-inspiration-mcp-server",
  "version": "1.0.0",
  "description": "MCP server that searches Awwwards.com for UI design inspiration",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "design-inspiration-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "npm run build && vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design",
    "inspiration",
    "awwwards",
    "ui",
    "ux"
  ],
  "author": "Yonas Valentin",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.2"
  },
  "overrides": {
    "@hono/node-server": "^1.19.15",
    "body-parser": "^2.3.0",
    "express-rate-limit": "^8.2.2",
    "fast-uri": "^3.1.6",
    "hono": "^4.13.5",
    "ip-address": "^10.3.1",
    "path-to-regexp": "^8.4.0",
    "qs": "^6.16.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@vitest/coverage-v8": "^5.0.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
